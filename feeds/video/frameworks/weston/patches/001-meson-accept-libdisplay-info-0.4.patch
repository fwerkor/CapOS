From 306a7b032550bfbdcc7afb9086ff5e55c87461c6 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Tue, 8 Sep 2026 19:00:55 +0100
Subject: [PATCH] meson: accept libdisplay-info 0.4

libdisplay-info 0.4.0 keeps every function libweston uses; only the
soname changed. Raise the upper bound of the version constraint so a
system 0.4 library is used rather than the bundled 0.2.0 subproject.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/meson.build
+++ b/meson.build
@@ -179,7 +179,7 @@ endif
 
 dep_libdisplay_info = dependency(
 	'libdisplay-info',
-	version: ['>= 0.2.0', '< 0.4.0'],
+	version: ['>= 0.2.0', '< 0.5.0'],
 	fallback: ['display-info', 'di_dep'],
 	default_options: [
 		'werror=false',
